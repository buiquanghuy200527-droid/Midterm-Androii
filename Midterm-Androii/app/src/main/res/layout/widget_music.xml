<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_music_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Music Player"
        android:textColor="#F9FAFB"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_music_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa phát"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/btn_music_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Bài trước"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/btn_music_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Phát/Tạm dừng"
            android:src="@android:drawable/ic_media_play"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/btn_music_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Bài tiếp"
            android:src="@android:drawable/ic_media_next" />

    </LinearLayout>

</LinearLayout>
